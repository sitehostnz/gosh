*.test


*.orig


### Go Patch ###
/vendor/
/Godeps/
.DS_Store
.idea
.vscode
.env
coverage.txt
bin

# Raw API recordings: live customer data, and credentials the recorder
# reduces but cannot promise to remove. Run them through
# internal/scrubtool before committing anything derived from them.
**/recordings/

# Python bytecode from the pre-MR checker. Committed once, which is how
# it got a rule: running the script writes it beside the source, and a
# scoped "git add .claude/" picks it up without anyone deciding to.
__pycache__/
*.pyc
